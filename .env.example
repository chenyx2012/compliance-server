APP_NAME=compliance-gateway
ENV=dev

# Gateway
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173
TEMP_STORAGE_ROOT=/tmp

# S1 OAT：首次部署执行 `python scripts/fetch_oat.py` 拉取到 OAT_REPO_DIR
OAT_REPO_URL=https://gitcode.com/HiAgent/compliance.git
OAT_REPO_REF=
OAT_REPO_DIR=app/tools/compliance
OAT_PYTHON_SUBDIR=OAT_python

# Upstream services (4 modules)
SERVICE_A_BASE_URL=http://127.0.0.1:9001
SERVICE_B_BASE_URL=http://127.0.0.1:9002
SERVICE_C_BASE_URL=http://127.0.0.1:9003
SERVICE_D_BASE_URL=http://127.0.0.1:9004
UPSTREAM_TIMEOUT_SECONDS=30

# Celery / Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_QUEUE=compliance_scan
CELERY_QUEUE_SCAN_PR=scan_pr
CELERY_QUEUE_SCAN_VERSION=scan_version
CELERY_QUEUE_PARSE=parse
CELERY_QUEUE_IMPORT=import
CELERY_RESULT_EXPIRES_SECONDS=86400
S2_ACCEPT_TIMEOUT_SECONDS=120
NOTIFY_REQUIRE_ENQUEUE=true
PR_POSTPROCESS_IMPORTS=false
PR_POSTPROCESS_AI_VERIFY=true

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=compliance_gateway
MYSQL_CHARSET=utf8mb4

# ---------- MinIO（docker compose 默认）----------
# docker compose up -d 后即可用以下配置
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=compliance
S3_BUCKET_PATH=csv/
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
S3_DOWNLOAD_PATH=temp/scan_results
# 兼容旧字段（可与 ACCESS_KEY 相同）
S3_APP_TOKEN=minioadmin
S3_UPLOADER_SCRIPT=s3_uploader.py

# S2 AICodeScan
AI_CODE_SCAN_SERVICE_URL=http://127.0.0.1:8002
OSC_NOTIFY_URL=http://127.0.0.1:8000/api/scan/notify

# compliance-sentry
COMPLIANCE_SENTRY_BASE_URL=http://127.0.0.1:8010
COMPLIANCE_SENTRY_USERNAME=admin
COMPLIANCE_SENTRY_PASSWORD=your_sentry_password
COMPLIANCE_SENTRY_PROXY=

# AI（可选：OpenAI 兼容 / Ollama）
# AI_OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
# AI_OPENAI_COMPAT_API_KEY=ollama
# AI_OPENAI_COMPAT_MODEL=qwen2.5:3b
